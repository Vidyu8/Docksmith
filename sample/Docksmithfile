# Sample app: exercises all six instructions (FROM COPY RUN WORKDIR ENV CMD).
# No network is needed at build or run time: everything is bundled.
FROM alpine:3.18
WORKDIR /app
ENV APP_NAME=Docksmith
ENV GREETING=Hello
RUN mkdir -p /app/data && echo "dependency layer ready" > /app/data/setup.txt
COPY app/ /app/
RUN chmod +x /app/run.sh && echo "build complete" > /app/BUILD_INFO
CMD ["/app/run.sh"]
